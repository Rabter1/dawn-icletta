y_info' | t }}</strong></p>\n\n          {%- if safety_meta.type contains 'list' -%}\n            <ul style=\"padding-left: 1.2em\">\n              {%- for f in safety_meta.value -%}\n                {%- if f and f.url != blank -%}\n                  {%- assign file_name = f.url | split: '/' | last | split: '?' | first -%}\n                  <li><a href=\"{{ f.url }}\" target=\"_blank\" rel=\"noopener noreferrer\">{{ file_name }}</a></li>\n                {%- endif -%}\n              {%- endfor -%}\n            </ul>\n          {%- else -%}\n            {%- assign file_name = file.url | split: '/' | last | split: '?' | first -%}\n            <p>\n              <a href=\"{{ file.url }}\" target=\"_blank\" rel=\"noopener noreferrer\">\n                {{ 'icletta.product.accordion.product_information.download_label' | t: filename: file_name }}\n              </a>\n            </p>\n          {%- endif -%}\n        {%- endif -%}\n      {%- endif -%}\n    </div>\n  </details>\n</div>"
